{
  "schemaVersion": 1,
  "assertions": [
    {
      "id": "head-commit-message",
      "kind": "gitLog",
      "headMessageEquals": "chore: commit finished work"
    },
    {
      "id": "only-experiment-left-unstaged",
      "kind": "gitStatus",
      "expect": [" M src/app.js"]
    },
    {
      "id": "readme-updated",
      "kind": "fileContains",
      "path": "README.md",
      "all": ["Status: maintained"]
    },
    {
      "id": "notes-untouched",
      "kind": "fileContains",
      "path": "docs/notes.md",
      "all": ["Do not edit this file."]
    }
  ]
}
